# Example dev values for @pantry/env. Copy to .env.development (gitignored).
# The local libSQL container accepts any auth token, so these values are not secrets.
#
# Write a worktree-specific .env.development.local to override values per checkout:
#   TURSO_PROJECT=pantry-<hash>
#   TURSO_PORT=<1024-65535>
#   TURSO_CONNECTION_URL=http://127.0.0.1:<port>
APP_ENV=development
TURSO_CONNECTION_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=local-development-token
# At least 32 characters (Better Auth rejects shorter secrets).
BETTER_AUTH_SECRET=local-development-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3000
