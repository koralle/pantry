# Pantry environment schema (Varlock).
# https://varlock.dev/guides/schema/
#
# The schema is split by concern under ./schemas; consumers import the keys they
# need with @import(..., pick=[...]) (see README.md).
#
# Values live in gitignored .env files next to this schema:
#   .env / .env.development    shared local values (symlinked across git worktrees)
#   .env.development.local     per-worktree overrides for the libSQL container
#   .env.production            production values
# @currentEnv=$APP_ENV
# @defaultSensitive=false
# @import(./schemas/.env.db)
# @import(./schemas/.env.auth)
# @import(./schemas/.env.local-libsql)
# ---

# Current environment. Selects which .env.<env> file is loaded.
# Local commands default to development; production deploy sets it explicitly.
# @type=enum(development, test, production)
APP_ENV=development
