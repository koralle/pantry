# Worktree-local libSQL container settings, consumed by @pantry/web (and TURSO_PORT by apps/api/scripts for the seed port check).
# @defaultSensitive=false
# ---

# Host port for the worktree-local libSQL container (docker compose).
# scripts/symlink-env-for-worktree.ts writes a unique value per git worktree
# into .env.development.local so each worktree can run its own container.
# @type=port(min=1024,max=65535)
# @example="8080"
TURSO_PORT=8080

# Docker Compose project/container name for the worktree-local libSQL container.
# @type=string
# @example="pantry"
TURSO_PROJECT=pantry
