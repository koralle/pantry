# libSQL (Turso) connection settings, consumed by @pantry/db, @pantry/api and @pantry/web.
# @defaultSensitive=false
# ---

# libSQL (Turso) connection URL used by Node tooling and the Worker runtime.
# The local libSQL container accepts any auth token.
# @type=url
# @example="http://127.0.0.1:8080"
TURSO_CONNECTION_URL=

# Auth token for the libSQL connection.
# @sensitive
# @example="local-development-token"
TURSO_AUTH_TOKEN=
