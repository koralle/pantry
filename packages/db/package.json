{
  "name": "@pantry/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./schema/*": "./src/schema/*.ts",
    "./tag-name": "./src/tag-name.ts"
  },
  "scripts": {
    "check:migrations": "tsx scripts/check-migrations.ts",
    "migrate:dev": "drizzle-kit migrate",
    "migrate:prod": "drizzle-kit migrate",
    "studio:dev": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@libsql/client": "catalog:database",
    "drizzle-orm": "catalog:database",
    "valibot": "catalog:validation"
  },
  "devDependencies": {
    "@pantry/env": "workspace:*",
    "@pantry/forge": "workspace:*",
    "@tursodatabase/database": "catalog:database",
    "@types/node": "catalog:runtime",
    "drizzle-kit": "catalog:database",
    "tsx": "catalog:script",
    "typescript": "catalog:typescript",
    "vitest": "catalog:test"
  }
}
