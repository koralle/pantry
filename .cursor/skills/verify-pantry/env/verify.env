# Verification-only overrides. launch.sh exports these before every command, so
# they win over the values in packages/env/ (loadDevEnv never overwrites an
# existing process.env value).
APP_ENV=development
TURSO_PROJECT=pantry-verify
TURSO_PORT=18080
TURSO_CONNECTION_URL=http://127.0.0.1:18080
TURSO_AUTH_TOKEN=pantry-verify-token
BETTER_AUTH_URL=http://127.0.0.1:4173
BETTER_AUTH_SECRET=pantry-verify-secret-at-least-32-characters
