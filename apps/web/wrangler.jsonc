{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantry",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
  },
  // `/rpc/*` と `/api/auth/*` は src/server.ts がこの binding（pantry-api）へ転送する。
  // 本番では pantry-api を先にデプロイしておく（.github/workflows/workflow.yaml）。
  "services": [{ "binding": "API", "service": "pantry-api" }],
}
