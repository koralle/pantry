# Pantry API maintenance scripts environment schema (Varlock).
# https://varlock.dev/guides/schema/
#
# Used only by the Node scripts in this directory (seed / create-user), via
# `varlock run --path scripts/`. The Worker reads apps/api/.env.schema, which
# does not pick TURSO_PORT, so the port never lands in the production Worker env.
# TURSO_PORT lets scripts/seed.ts refuse to reset a local database whose port
# disagrees with TURSO_CONNECTION_URL.
# Overrides for scripts go in apps/api/scripts/.env.local (not apps/api/.env.local).
# @import(../../../packages/env/, pick=[APP_ENV, TURSO_CONNECTION_URL, TURSO_AUTH_TOKEN, TURSO_PORT, BETTER_AUTH_*])
# ---
