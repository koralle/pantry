{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantry-api",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "observability": {
    "enabled": true,
  },
  // ブラウザは apps/web からのみ到達する。web の Worker entry（apps/web/src/server.ts）が
  // `/rpc/*` と `/api/auth/*` を Service Binding でこの Worker へ渡すため、公開URLは持たない。
  "workers_dev": false,
  "preview_urls": false,
}
