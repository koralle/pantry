{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantry-api",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "observability": {
    "enabled": true,
  },
  // ブラウザは apps/web からのみ到達する。PR 3 で web から Service Binding を張り、
  // その先の `/rpc/*` と `/api/auth/*` をこの Worker が受けるため、公開URLは持たない。
  "workers_dev": false,
  "preview_urls": false,
}
