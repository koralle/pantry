{
  "name": "@pantry/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "db:create-user": "tsx scripts/create-user.ts",
    "db:seed": "tsx scripts/seed.ts",
    "deploy": "pnpm run build && wrangler deploy --keep-vars",
    "dev": "vite dev --port 8787",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run --project workers --project node",
    "test:db": "vitest run --project db",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:authentication",
    "@better-auth/passkey": "catalog:authentication",
    "@orpc/server": "catalog:rpc",
    "@pantry/api-contract": "workspace:*",
    "@pantry/db": "workspace:*",
    "@pantry/utils": "workspace:*",
    "better-auth": "catalog:authentication",
    "drizzle-orm": "catalog:database",
    "hono": "catalog:server",
    "valibot": "catalog:validation"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:build",
    "@cloudflare/vitest-plugin": "catalog:test",
    "@libsql/client": "catalog:database",
    "@orpc/client": "catalog:rpc",
    "@orpc/contract": "catalog:rpc",
    "@pantry/env": "workspace:*",
    "@pantry/forge": "workspace:*",
    "@pantry/test-support": "workspace:*",
    "@types/node": "catalog:runtime",
    "drizzle-seed": "catalog:database",
    "tsx": "catalog:script",
    "typescript": "catalog:typescript",
    "uuidv7": "catalog:uuid",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "wrangler": "catalog:runtime"
  }
}
