{
  "name": "@pantry/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @pantry/web run build",
    "build-storybook": "pnpm --filter @pantry/web run build-storybook",
    "cf-typegen": "pnpm --filter @pantry/web run cf-typegen",
    "check": "ultracite check --type-aware",
    "db:seed": "pnpm --filter @pantry/web run db:seed",
    "deploy": "pnpm --filter @pantry/web run deploy",
    "dev": "pnpm --filter @pantry/web run dev",
    "fix": "ultracite fix --type-aware --no-error-on-unmatched-pattern",
    "knip": "knip",
    "lint:markup": "markuplint \"**/*.{tsx,jsx}\"",
    "migrate:dev": "pnpm --filter @pantry/web run migrate:dev",
    "migrate:prod": "pnpm --filter @pantry/web run migrate:prod",
    "panda:codegen": "pnpm --filter @pantry/web run panda:codegen",
    "panda:mcp": "pnpm --filter @pantry/web run panda:mcp",
    "preview": "pnpm --filter @pantry/web run preview",
    "storybook": "pnpm --filter @pantry/web run storybook",
    "studio:dev": "pnpm --filter @pantry/web run studio:dev",
    "test": "pnpm --filter @pantry/web run test",
    "test:persistence": "pnpm --filter @pantry/web run test:persistence",
    "typecheck": "tsc && pnpm --filter @pantry/web run typecheck"
  },
  "devDependencies": {
    "@markuplint/jsx-parser": "catalog:lint",
    "@markuplint/react-spec": "catalog:lint",
    "@tsconfig/strictest": "catalog:typescript",
    "knip": "catalog:lint",
    "lefthook": "catalog:githooks",
    "markuplint": "catalog:lint",
    "oxfmt": "catalog:format",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "typescript": "catalog:typescript",
    "ultracite": "catalog:lint"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
