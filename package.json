{
  "name": "@pantry/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build-storybook": "pnpm --filter @pantry/web run build-storybook",
    "cf-typegen": "pnpm -r run cf-typegen",
    "check": "turbo run check:root",
    "check:root": "ultracite check --type-aware",
    "db:seed": "pnpm --filter @pantry/api run db:seed",
    "deploy": "pnpm --filter @pantry/web run deploy",
    "deploy:api": "pnpm --filter @pantry/api run deploy",
    "dev": "pnpm --filter @pantry/web run dev",
    "dev:api": "pnpm --filter @pantry/api run dev",
    "fix": "ultracite fix --type-aware --no-error-on-unmatched-pattern",
    "knip": "turbo run knip:root",
    "knip:root": "knip",
    "lint:markup": "turbo run lint:markup:root",
    "lint:markup:root": "markuplint \"**/*.{tsx,jsx}\"",
    "migrate:dev": "pnpm --filter @pantry/db run migrate:dev",
    "migrate:prod": "pnpm --filter @pantry/db run migrate:prod",
    "panda:codegen": "turbo run panda:codegen",
    "panda:mcp": "pnpm --filter @pantry/web run panda:mcp",
    "preview": "pnpm --filter @pantry/web run preview",
    "repo-source": "node --eval \"process.exit(0)\"",
    "storybook": "pnpm --filter @pantry/web run storybook",
    "studio:dev": "pnpm --filter @pantry/db run studio:dev",
    "test": "turbo run test",
    "test:persistence": "pnpm --filter @pantry/web --filter @pantry/api run test:persistence",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc",
    "varlock-inputs": "node --eval \"process.exit(0)\""
  },
  "devDependencies": {
    "@markuplint/jsx-parser": "catalog:lint",
    "@markuplint/react-spec": "catalog:lint",
    "@tsconfig/strictest": "catalog:typescript",
    "knip": "catalog:lint",
    "lefthook": "catalog:githooks",
    "markuplint": "catalog:lint",
    "oxfmt": "catalog:format",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "turbo": "catalog:build",
    "typescript": "catalog:typescript",
    "ultracite": "catalog:lint"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
