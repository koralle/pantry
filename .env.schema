# Pantry environment schema (Varlock).
# https://varlock.dev/guides/schema/
#
# Values live in gitignored .env files:
#   .env / .env.development    shared local values (symlinked across git worktrees)
#   .env.development.local     per-worktree overrides for the libSQL container
#   .env.production            production values
# @currentEnv=$APP_ENV
# @defaultSensitive=false
# ---

# Current environment. Selects which .env.<env> file is loaded.
# Local commands default to development; production deploy sets it explicitly.
# @type=enum(development, test, production)
APP_ENV=development

# libSQL (Turso) connection URL used by Node tooling and the Worker runtime.
# The local libSQL container accepts any auth token.
# @type=url
# @example="http://127.0.0.1:8080"
TURSO_CONNECTION_URL=

# Auth token for the libSQL connection.
# @sensitive
# @example="local-development-token"
TURSO_AUTH_TOKEN=

# Better Auth signing secret. Must be at least 32 characters.
# @type=string(minLength=32)
# @sensitive
# @example="local-development-secret-change-me-32chars"
BETTER_AUTH_SECRET=

# Origin Pantry is served from. Used by Better Auth and passkeys.
# @type=url
# @example="http://localhost:3000"
BETTER_AUTH_URL=

# Host port for the worktree-local libSQL container (docker compose).
# scripts/symlink-env-for-worktree.ts writes a unique value per git worktree
# into .env.development.local so each worktree can run its own container.
# @type=port(min=1024,max=65535)
# @example="8080"
TURSO_PORT=8080

# Docker Compose project/container name for the worktree-local libSQL container.
# @type=string
# @example="pantry"
TURSO_PROJECT=pantry
